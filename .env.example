# Site Configuration
NEXT_PUBLIC_SITE_URL=https://arvishhafoundation.org
NEXT_PUBLIC_SITE_NAME="Arvishha Foundation"

# Maintenance Mode Configuration (set to "false" to disable globally)
MAINTENANCE_MODE=true

# Payload CMS Configuration
PAYLOAD_SECRET=your_payload_secret_key
DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.mongodb.net/

# S3 / Object Storage Configuration (AWS S3, Supabase S3, Cloudflare R2, MinIO)
# Accepts S3_BUCKET_NAME or S3_BUCKET
S3_BUCKET_NAME=arvishhafoundation
# Accepts S3_ACCESS_KEY or S3_ACCESS_KEY_ID
S3_ACCESS_KEY=your_s3_access_key
# Accepts S3_SECRET_KEY or S3_SECRET_ACCESS_KEY
S3_SECRET_KEY=your_s3_secret_key
# S3 compatible endpoint (required for Supabase, MinIO, R2, etc. Omit for standard AWS S3)
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-northeast-1
# S3_PREFIX=media
# S3_PUBLIC_URL=https://<project-ref>.storage.supabase.co/storage/v1/object/public/arvishhafoundation

